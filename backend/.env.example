# ============================================================
# SynthDraft 后端环境变量示例
#
# 使用方法：
#   cp backend/.env.example backend/.env
#   然后按需修改各字段值
#
# 说明：
# - 所有字段对应 app/config.py 中的 Settings 类（大小写不敏感）
# - 留空的字段（如 API_KEY）需在部署前填写
# - 标注 [SECURE] 的字段在生产环境必须替换为强随机值
# ============================================================

# ===== 应用元信息 =====
# 运行环境：development / staging / production
APP_ENV=development
# 调试模式（生产环境必须为 false）
APP_DEBUG=true
# 服务名称（用于日志、健康检查、OpenTelemetry）
APP_NAME=SynthDraft Backend
# 应用版本号
APP_VERSION=0.1.0
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=DEBUG
# 文件上传临时目录
UPLOAD_DIR=./tmp_uploads

# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=synthdraft
# [SECURE] 生产环境必须替换
POSTGRES_PASSWORD=synthdraft_dev_pwd
POSTGRES_DB=synthdraft
# 异步驱动 asyncpg，格式：postgresql+asyncpg://user:pwd@host:port/db
DATABASE_URL=postgresql+asyncpg://synthdraft:synthdraft_dev_pwd@localhost:5433/synthdraft

# ===== Redis / Celery =====
REDIS_HOST=localhost
REDIS_PORT=6379
# 默认 DB 0 给应用缓存
REDIS_URL=redis://localhost:6379/0
# Celery broker 使用 DB 1
CELERY_BROKER_URL=redis://localhost:6379/1
# Celery result backend 使用 DB 2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== Qdrant 向量数据库 =====
QDRANT_URL=http://localhost:6333

# ===== MinIO 对象存储 =====
# P0 阶段可不启动，降级为本地 tmp_uploads/
MINIO_ENDPOINT=localhost:9000
# [SECURE] 生产环境必须替换
MINIO_ACCESS_KEY=synthdraft_minio
# [SECURE] 生产环境必须替换
MINIO_SECRET_KEY=synthdraft_minio_secret
MINIO_BUCKET=synthdraft-files
# 是否启用 HTTPS（生产环境建议 true）
MINIO_SECURE=false

# ===== Ollama / vLLM =====
# Ollama 服务地址
OLLAMA_HOST_URL=http://localhost:11434
# vLLM OpenAI 兼容端点
VLLM_BASE_URL=http://localhost:8001/v1

# ===== LLM 模型 =====
# LLM 提供方：ollama / openai / anthropic
LLM_PROVIDER=ollama
# 文本对话模型
LLM_MODEL=qwen2.5-coder:7b
# 视觉模型（多模态）
VLM_MODEL=qwen2.5-vl:7b
# 嵌入模型
EMBEDDING_MODEL=bge-m3

# ===== OpenAI 兼容（vLLM / DeepSeek / 通义千问 / 智谱 GLM / OpenAI 官方）=====
# [SECURE] 留空表示不启用 OpenAI 兼容 provider
OPENAI_API_KEY=
# 端点 URL：切换至 DeepSeek / 通义千问 / 智谱 GLM / vLLM 等兼容端点
OPENAI_BASE_URL=https://api.openai.com/v1
# 文本模型
OPENAI_MODEL=gpt-4o-mini
# 视觉模型（留空则 is_vlm_available 返回 false）
OPENAI_VLM_MODEL=gpt-4o

# ===== Anthropic Claude =====
# [SECURE] 留空表示不启用 Anthropic provider
ANTHROPIC_API_KEY=
# 端点 URL（一般无需修改）
ANTHROPIC_BASE_URL=https://api.anthropic.com
# 文本模型
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# 视觉模型（Claude 3.5 Sonnet 同时支持文本与视觉）
ANTHROPIC_VLM_MODEL=claude-3-5-sonnet-latest

# ===== JWT =====
# [SECURE] 生产环境必须替换为强随机串（建议 openssl rand -hex 32）
JWT_SECRET_KEY=change-this-in-production-use-a-strong-random-secret
JWT_ALGORITHM=HS256
# Access Token 过期时间（分钟），默认 24 小时
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== OpenTelemetry =====
# OTLP 接收端点，留空表示不导出
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=synthdraft-backend
# 是否启用 OTel tracing
OTEL_ENABLED=false

# ===== CORS =====
# 允许的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
