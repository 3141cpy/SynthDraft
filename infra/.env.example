# ============================================================
# SynthDraft 开发环境配置 (.env.example)
# 使用前拷贝为 .env: cp .env.example .env (Linux) / copy .env.example .env (Windows)
# ============================================================

# ===== PostgreSQL =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=synthdraft
POSTGRES_PASSWORD=synthdraft_dev_pwd
POSTGRES_DB=synthdraft
# SQLAlchemy 异步连接串（backend 容器内使用）
DATABASE_URL=postgresql+asyncpg://synthdraft:synthdraft_dev_pwd@postgres:5432/synthdraft
# 本地开发（非容器）连接串
DATABASE_URL_LOCAL=postgresql+asyncpg://synthdraft:synthdraft_dev_pwd@localhost:5432/synthdraft

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_URL_LOCAL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===== Qdrant =====
QDRANT_URL=http://qdrant:6333
QDRANT_URL_LOCAL=http://localhost:6333

# ===== MinIO =====
MINIO_ENDPOINT=minio:9000
MINIO_ENDPOINT_LOCAL=localhost:9000
MINIO_ACCESS_KEY=synthdraft_minio
MINIO_SECRET_KEY=synthdraft_minio_secret
MINIO_BUCKET=synthdraft-files
MINIO_SECURE=false

# ====================================================================
# AI Provider 配置（已迁移到数据库，通过前端 /settings 页面管理）
# ====================================================================
# 以下字段仅作首次启动迁移源使用：应用首次启动且数据库无 provider 配置时，
# 会根据 LLM_PROVIDER 自动迁移为一条数据库记录。
# 后续配置变更请通过前端 /settings 页面或 /api/v1/ai/config API 完成，
# 修改此处的字段不会影响已迁移的运行时配置。
# ====================================================================

# ===== Ollama =====
OLLAMA_HOST_URL=http://ollama:11434
OLLAMA_HOST_URL_LOCAL=http://localhost:11434

# ===== vLLM（GPU 节点，P0 可不启用）=====
VLLM_BASE_URL=http://vllm:8000/v1

# ===== LLM 模型配置 =====
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
VLM_MODEL=qwen2.5-vl:7b
EMBEDDING_MODEL=bge-m3

# ===== JWT 安全配置 =====
JWT_SECRET_KEY=change-this-in-production-use-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 应用配置 =====
APP_ENV=development
APP_DEBUG=true
APP_NAME=SynthDraft Backend
APP_VERSION=0.1.0
LOG_LEVEL=DEBUG
# 临时文件上传目录
UPLOAD_DIR=./tmp_uploads

# ===== OpenTelemetry =====
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=synthdraft-backend
OTEL_ENABLED=false

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
